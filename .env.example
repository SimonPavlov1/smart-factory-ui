# Copy to .env on the server and replace every CHANGE_ME value.
APP_PORT=80
# Set the server LAN address to avoid listening on unrelated interfaces.
BIND_ADDRESS=192.168.1.50

POSTGRES_DB=smart_factory
POSTGRES_USER=smart_factory
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

AUTH_SECRET_KEY=CHANGE_ME_LONG_RANDOM_AUTH_SECRET
AUTH_TOKEN_TTL_HOURS=12

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
